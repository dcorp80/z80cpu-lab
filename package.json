{
  "name": "z80cpu-lab",
  "version": "0.0.0",
  "description": "Companion toolkit for @dcorp80/z80cpu: debugger, disassembler, REPL, benchmarks.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "repl:mixer": "npm run build -w @dcorp80/z80cpu-cli && node packages/z80cpu-cli/dist/repl.js packages/z80cpu-bench/src/mixer.bin",
    "bench": "npm test -w @dcorp80/z80cpu-bench"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
